# Copy to .env (never commit .env). All values optional.
# Authorized traffic API (provider interface only; no vendor is hard-wired)
TRAFFIC_API_KEY=
TRAFFIC_API_BASE_URL=
TRAFFIC_API_MAX_AGE_MINUTES=15
# Address search via Nominatim (needs internet; respect its usage policy)
ENABLE_GEOCODING=0
GEOCODER_USER_AGENT=ai-traffic-forecasting-demo
